# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional / External APIs (Free Tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENWEATHER_API_KEY=your-openweather-api-key
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Server-only secrets. Leave unset until each integration is configured.
CRON_SECRET=
# One-time account and market seed route. Set a long random value in production.
PASARIN_SEED_SECRET=
PASARIN_SESSION_SECRET=
# Opt-in for server-side Supabase Auth session mode
# PASARIN_SERVER_AUTH=1
# NEXT_PUBLIC_PASARIN_SERVER_AUTH=1
TELEGRAM_WEBHOOK_SECRET=
# Set on local development only to test the Supabase storage backend.
# PASARIN_STATE_BACKEND=supabase
# SUPABASE_DB_URL=postgresql://user:password@host:5432/postgres

# Batas panggilan Gemini per hari per instans server (opsional, bawaan 200).
# Setelah batas tercapai, penjelasan memakai template tanpa AI.
AI_DAILY_CALL_LIMIT=200

# Sumber cuaca kedua tanpa kunci (Open-Meteo), dipakai bila OpenWeather tidak ada atau gagal.
# Aktif otomatis di produksi; isi 1 untuk mengaktifkan di lokal, atau 0 untuk mematikan. Gratis hanya untuk non-komersial.
# PASARIN_WEATHER_OPEN_METEO=1
