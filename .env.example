# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional / External APIs (Free Tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENWEATHER_API_KEY=your-openweather-api-key
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Server-only secrets. Leave unset until each integration is configured.
CRON_SECRET=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_CHAT_ACCOUNTS={}
# Set on local development only to test the Supabase storage backend.
# PASARIN_STATE_BACKEND=supabase
# SUPABASE_DB_URL=postgresql://user:password@host:5432/postgres
