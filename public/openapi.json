  "components": {
    "securitySchemes": {
      "SupabaseBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "CronBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Nilai CRON_SECRET yang dikonfigurasi pada server."
      },
      "TelegramSecret": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Telegram-Bot-Api-Secret-Token"
      }
    }
  }
