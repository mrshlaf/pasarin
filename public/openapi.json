          }
        }
      },
      "delete": {
        "summary": "Akhiri sesi tes lokal",
        "responses": {
          "204": {
            "description": "Cookie sesi dihapus"
          },
          "404": {
            "description": "Hanya tersedia di localhost dengan penyimpanan lokal."
          }
        }
      }
